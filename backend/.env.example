POSTGRES_USER=vocab
POSTGRES_PASSWORD=vocab
POSTGRES_DB=vocab
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vocab:vocab@localhost:5432/vocab
# Generate a unique value per environment with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-generated-secret
# JSON array of exact web-client origins (no trailing slash).
CORS_ORIGINS=["http://localhost:8081","http://192.168.0.50:8081"]
