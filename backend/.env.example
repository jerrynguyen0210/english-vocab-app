POSTGRES_USER=vocab
APP_ENVIRONMENT=development
# Required in preview/production: absolute path on persistent backup storage.
# MIGRATION_BACKUP_DIR=/var/backups/english-vocab/migrations
POSTGRES_PASSWORD=vocab
POSTGRES_DB=vocab
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vocab:vocab@localhost:5432/vocab
# Generate a unique value per environment with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-generated-secret
# JSON array of exact web-client origins (no trailing slash).
CORS_ORIGINS=["http://localhost:8081","http://192.168.0.50:8081"]

# Local HTTP only; keep true for deployed HTTPS.
AUTH_COOKIE_SECURE=false
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=2592000
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60

# Maximum recorded review attempts per user-local day.
REVIEW_DAILY_CAP=20

# Local/LAN Ollama server reachable from the backend (including from Docker).
OLLAMA_URL=http://192.168.0.108:11434
OLLAMA_MODEL=translategemma:4b
OLLAMA_TIMEOUT_SECONDS=500

# Stop automatic prompt generation after this many attempts; failed jobs remain inspectable.
PROMPT_JOB_MAX_ATTEMPTS=5
