{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "environment": "production",
      "distribution": "store",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://vocab.jerryitdev.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "release-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  }
}
