# Public configuration only. Copy to .env.local for local development.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.50:8001

# Optional browser override when opening the web app at localhost:8081.
# Use the same hostname as the web app to retain SameSite session cookies.
# Omit this override when browsing via the LAN address above.
# EXPO_PUBLIC_WEB_API_BASE_URL=http://localhost:8001

# Preview: set EXPO_PUBLIC_API_BASE_URL=https://preview-api.example.com
# Production: set EXPO_PUBLIC_API_BASE_URL=https://api.example.com
