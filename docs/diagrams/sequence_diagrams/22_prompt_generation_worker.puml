@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center
skinparam maxMessageSize 240
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #355777
skinparam ActorBorderColor #355777
skinparam ArrowColor #355777
hide footbox
autonumber
title Durable saved-word prompt generation and retry

' Sources relative to repository root:
' backend/app/services/prompt_jobs/worker.py
' backend/app/prompt_worker.py
' backend/app/llm/openrouter_review.py

participant "Prompt worker loop" as Loop
participant "Prompt job service" as Worker
database PostgreSQL as DB
participant "OpenRouter adapter" as LLM
Loop -> Worker : process_one(engine)
Worker -> DB : BEGIN; mark expired jobs at attempt limit terminal\nSELECT eligible job FOR UPDATE SKIP LOCKED
DB --> Worker : Job or none
alt No job / conditional claim lost
  Worker -> DB : End claim transaction
  Worker --> Loop : false
else Job claimed
  Worker -> DB : Conditional UPDATE lease UUID; increment attempts\navailable_at = now + provider timeout + 60s\nRead word / owner snapshot; COMMIT
  Worker -> LLM : generate_review(word, meaning, configured provider settings)
  ref over Worker, LLM : 25_openrouter_generation: capability fallback + strict local validation
  LLM --> Worker : Masked sentence or ReviewError / ValueError
  note over Worker, DB : No database transaction is held during provider generation.
  Worker -> DB : BEGIN; lock User; lock job matching word ID + lease token
  DB --> Worker : Owner and matching job, or missing
  alt Owner deleted or job deleted / lease replaced
    Worker -> DB : End transaction without applying result
  else Owner and lease match
    alt Generation succeeded
      Worker -> DB : UPDATE Word.review_prompt; DELETE PromptJob; COMMIT
    else Generation failed
      Worker -> DB : Clear lease; set failure_category
      alt Attempts reached configured maximum
        Worker -> DB : Set failed_at; COMMIT
      else Attempts remain
        Worker -> DB : Set retry time = now + min(3600, 5 * 2^min(attempts,10)) seconds\nCOMMIT
      end
    end
  end
  Worker --> Loop : true
end
note over Worker : Expired leases become claimable; crashed final attempts become terminal.\nTerminal failures can be reset through the operator retry CLI.
@enduml
