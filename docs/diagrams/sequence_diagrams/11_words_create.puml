@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center
skinparam maxMessageSize 240
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #355777
skinparam ActorBorderColor #355777
skinparam ArrowColor #355777
hide footbox
autonumber
title Save word and enqueue prompt generation

' Sources relative to repository root:
' backend/app/api/routes/words.py
' backend/app/services/words.py
' backend/app/services/reviews/prompts.py
' backend/app/services/common_word_bank.py

actor Client
participant "FastAPI route" as API
participant "Service" as S
database PostgreSQL as DB
ref over Client, DB : 02_access_authentication: resolve active bearer session or return 401
note over API : Invalid request parameters / body return 422 before service execution.

Client -> API : POST /api/v1/words (word, explanation, example)
API -> S : create_word(body, db, user)
S -> DB : Check user's normalized-word duplicate
break Known duplicate
  S --> API : WordAlreadyExists
  API --> Client : 409
end
S -> DB : Lock and recheck active User FOR UPDATE
break Account unavailable
  S --> API : AccountUnavailable
  API --> Client : 401
end
S -> S : Build initial masked example / explanation prompt
S -> DB : INSERT Word; FLUSH
S -> DB : INSERT ReviewState due now + PromptJob
opt A Common question exists for this saved word
  S -> DB : Count available Common questions; queue refill if <= 15
end
alt Insert / commit integrity conflict
  S -> DB : ROLLBACK; recheck duplicate
  alt Duplicate now exists
    S --> API : WordAlreadyExists
    API --> Client : 409
  else Unrelated integrity failure
    S --> API : Propagate unexpected database error
    API --> Client : Server error
  end
else Transaction succeeds
  S -> DB : COMMIT
  S --> API : WordCreated
  API --> Client : 201 saved word; Cache-Control: no-store
  ref over S, DB : 22_prompt_generation_worker and 24_embedding_worker run asynchronously
end
@enduml
