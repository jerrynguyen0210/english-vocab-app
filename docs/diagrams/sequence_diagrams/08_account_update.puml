@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center
skinparam maxMessageSize 240
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #355777
skinparam ActorBorderColor #355777
skinparam ArrowColor #355777
hide footbox
autonumber
title Update account timezone

' Sources relative to repository root:
' backend/app/api/routes/account.py
' backend/app/services/accounts.py
' backend/app/schemas/account.py

actor Client
participant "FastAPI route" as API
participant "Service" as S
database PostgreSQL as DB
ref over Client, DB : 02_access_authentication: resolve active bearer session or return 401
note over API : Invalid request parameters / body return 422 before service execution.

Client -> API : PATCH /api/v1/account (timezone)
API -> S : update_account(db, user, body)
S -> DB : Lock active User FOR UPDATE; recheck active status
alt Account no longer active
  S --> API : AccountUnavailable
  API --> Client : 401 Account unavailable
else Account locked
  S -> DB : UPDATE timezone; COMMIT
  S --> API : Updated profile
  API --> Client : 200 AccountProfile; Cache-Control: no-store
end
@enduml
