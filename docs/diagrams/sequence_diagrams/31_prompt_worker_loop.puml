@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center
skinparam maxMessageSize 240
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #355777
skinparam ActorBorderColor #355777
skinparam ArrowColor #355777
hide footbox
autonumber
title Background prompt-worker orchestration and recovery

' Sources relative to repository root:
' backend/app/prompt_worker.py
' backend/app/services/prompt_jobs/worker.py

actor "Service runner / operator" as Operator
participant "app.prompt_worker" as Loop
participant "Saved-word prompt jobs" as Prompt
database PostgreSQL as DB
Operator -> Loop : python -m app.prompt_worker
Loop -> DB : Obtain configured engine
loop Until KeyboardInterrupt
  Loop -> Prompt : process_one(engine)
  ref over Prompt, DB : 22_prompt_generation_worker
  Prompt --> Loop : reviewed flag
  opt No saved-word job claimed
    Loop -> Loop : Wait 1 second
  end
  opt SQLAlchemyError during saved-word processing
    Loop -> Loop : Log fixed error; wait 5 seconds; continue next iteration
    note over Loop, DB : Crashed / incomplete jobs become claimable when leases expire.
  end
end
Operator -> Loop : KeyboardInterrupt
Loop -> DB : Dispose engine in finally
note over Loop : Provider errors are converted into saved-word job retry states.\nProposed Common generation runs on batch requests (20 / 23), not this worker.
@enduml
