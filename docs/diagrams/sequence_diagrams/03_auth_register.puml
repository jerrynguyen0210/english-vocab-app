@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center
skinparam maxMessageSize 240
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #355777
skinparam ActorBorderColor #355777
skinparam ArrowColor #355777
hide footbox
autonumber
title Register account and initial session

' Sources relative to repository root:
' backend/app/api/routes/auth.py
' backend/app/services/auth.py
' backend/app/api/auth_transport.py
' backend/app/schemas/auth.py

actor Client
participant "FastAPI route" as API
participant "Service" as S
database PostgreSQL as DB

Client -> API : POST /api/v1/auth/register (name, email, password, timezone)
ref over Client, DB : 01_auth_request_guard; validate registration body
API -> S : register(body, db, native_request)
S -> S : Lowercase email; Argon2 password hash
S -> DB : INSERT User; FLUSH
alt Integrity conflict
  DB --> S : IntegrityError
  S -> DB : ROLLBACK
  S --> API : RegistrationConflict
  API --> Client : 409 Unable to register this email
else User inserted
  S -> S : Generate opaque access and refresh tokens
  S -> DB : INSERT AuthSession with token digests and expiry\nCOMMIT user + session atomically
  S --> API : IssuedTokens (plaintext only in memory)
  alt Native transport
    API --> Client : 201 access_token + refresh_token + expires_in
  else Browser transport
    API --> Client : 201 access_token + expires_in\nSet HttpOnly, SameSite=Strict refresh cookie
  end
  note over API : Cache-Control: no-store; cookie Secure follows configuration.
end
@enduml
