@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center
skinparam maxMessageSize 240
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #355777
skinparam ActorBorderColor #355777
skinparam ArrowColor #355777
hide footbox
autonumber
title Inspect prompt queue or explicitly retry terminal failure

' Sources relative to repository root:
' backend/app/prompt_jobs.py
' backend/app/services/prompt_jobs/management.py

actor Operator
participant "app.prompt_jobs CLI" as CLI
participant "Queue management service" as Service
database PostgreSQL as DB
alt Status command
  Operator -> CLI : python -m app.prompt_jobs status
  CLI -> Service : queue_status(db)
  Service -> DB : Aggregate pending, in-flight, waiting-retry and failed jobs\nFind oldest pending availability
  DB --> Service : Counts and oldest timestamp
  Service -> DB : Read at most 20 terminal failure summaries
  DB --> Service : Word IDs, attempts, failure categories and timestamps
  Service --> CLI : Queue report
  CLI --> Operator : JSON report
else Retry command
  Operator -> CLI : python -m app.prompt_jobs retry --word-id UUID
  CLI -> Service : retry_failed_job(db, word_id)
  Service -> DB : Conditional UPDATE where word_id matches and failed_at is set\nClear failure / lease; attempts=0; available_at=now
  alt No failed job matched
    DB --> Service : No row
    Service --> CLI : LookupError
    CLI --> Operator : Exit 1; Failed prompt job not found
  else Failed job reset
    Service -> DB : COMMIT
    Service --> CLI : Done
    CLI --> Operator : Failed prompt job queued for retry
    ref over Service, DB : 22_prompt_generation_worker processes reset job later
  end
end
CLI -> DB : Close session and dispose engine in finally
note over CLI : Operator commands are separate from the HTTP API.\nCommon-word failures use automatic request-driven cooldown recovery.
@enduml
