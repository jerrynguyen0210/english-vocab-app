@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center
skinparam maxMessageSize 240
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #355777
skinparam ActorBorderColor #355777
skinparam ArrowColor #355777
hide footbox
autonumber
title Mark a correctly answered Common word learned

' Sources relative to repository root:
' backend/app/api/routes/common_words.py
' backend/app/services/common_words.py
' backend/app/services/common_word_bank.py

actor Client
participant "FastAPI route" as API
participant "Service" as S
database PostgreSQL as DB
ref over Client, DB : 02_access_authentication: resolve active bearer session or return 401
note over API : Invalid request parameters / body return 422 before service execution.

Client -> API : POST /api/v1/common-words/{question_id}/learned (selected_index)
API -> S : mark_learned(db, user, question_id, selected_index)
S -> DB : Lock and recheck active User FOR UPDATE
break Account unavailable
  S --> API : AccountUnavailable
  API --> Client : 401
end
S -> DB : Load owned CommonWordQuestion
DB --> S : Question or none
alt Missing / another user's question
  S --> API : CommonQuestionNotFound
  API --> Client : 404
else Selected index incorrect
  S --> API : InvalidCommonAnswer
  API --> Client : 422 Choose the correct meaning
else Correct selected index
  opt First successful learning
    S -> DB : Set learned_at=now
  end
  S -> DB : FLUSH; count available bank\nQueue / reset refill if <= 15, respecting cooldown; COMMIT
  S --> API : Done
  API --> Client : 204; Cache-Control: no-store
  note over S : Exact retries preserve original learned_at.\nLearning does not save the word into the review bank.
end
@enduml
