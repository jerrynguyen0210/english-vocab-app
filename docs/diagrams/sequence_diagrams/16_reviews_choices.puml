@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center
skinparam maxMessageSize 240
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #355777
skinparam ActorBorderColor #355777
skinparam ArrowColor #355777
hide footbox
autonumber
title Switch an existing review to multiple choice

' Sources relative to repository root:
' backend/app/api/routes/reviews.py
' backend/app/services/reviews/service.py
' backend/app/services/reviews/tickets.py
' backend/app/services/reviews/choices.py

actor Client
participant "FastAPI route" as API
participant "Service" as S
database PostgreSQL as DB
ref over Client, DB : 02_access_authentication: resolve active bearer session or return 401
note over API : Invalid request parameters / body return 422 before service execution.

Client -> API : POST /api/v1/reviews/{word_id}/choices\n(attempt_id, review_token)
API -> S : word_choices(word_id, body, db, user)
S -> DB : Load owned Word + ReviewState
DB --> S : Pair or none
alt No owned review item
  S --> API : ReviewNotFound
  API --> Client : 404
else Item exists
  S -> S : Verify HMAC, expiry, user, word, attempt and state snapshot
  alt Invalid / expired / changed ticket
    S --> API : ReviewConflict
    API --> Client : 409 Start a new review
  else Valid ticket
    ref over S, DB : 19_choice_generation
    S -> S : Mask prompt and hints; retain original attempt and ticket
    S --> API : SessionItem with four choices
    API --> Client : 200; Cache-Control: no-store
  end
end
@enduml
